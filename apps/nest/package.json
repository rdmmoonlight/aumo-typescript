{
    "name": "@app/nest",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "main": "dist/main.js",
    "files": [
        "dist"
    ],
    "scripts": {
        "clean": "rimraf dist .tscache tsconfig.tsbuildinfo node_modules/.cache",
        "build": "nest build",
        "dev": "nest start --watch",
        "start": "node dist/main.js",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:pull": "drizzle-kit pull",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@app/logger": "workspace:*",
        "@aws-sdk/client-s3": "^3.1147.0",
        "@aws-sdk/s3-request-presigner": "^3.1148.0",
        "@neon/config": "^1.8.4",
        "@neon/env": "^1.5.1",
        "@neondatabase/serverless": "^1.2.0",
        "@nestjs/axios": "^12.0.1",
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^12.0.1",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@nestjs/swagger": "^11.0.0",
        "@scalar/nestjs-api-reference": "^0.3.0",
        "axios": "^1.20.0",
        "bcrypt": "^6.0.0",
        "bullmq": "^6.3.11",
        "dotenv": "^18.0.5",
        "drizzle-orm": "^0.45.4",
        "exceljs": "^4.4.0",
        "helmet": "^8.1.0",
        "ioredis": "^6.0.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^1.4.5-lts.1",
        "pg": "^8.23.1",
        "postgres": "^3.4.9",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.0",
        "@swc/core": "^1.16.18",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.0",
        "@types/ioredis": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^1.4.12",
        "@types/node": "^24.0.0",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^6.0.3",
        "@vitest/coverage-v8": "^3.0.0",
        "drizzle-kit": "^0.31.11",
        "rimraf": "^6.1.3",
        "supertest": "^7.1.4",
        "tsx": "^4.23.15",
        "typescript": "^5.3.3",
        "unplugin-swc": "^2.0.0",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.0.0"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@nx-dotnet/core",
            "unrs-resolver"
        ]
    }
}
