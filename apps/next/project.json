{
    "name": "@app/next",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/next",
    "targets": {
        "lint": {
          "executor": "@nx/eslint:lint",
          "outputs": ["{options.outputFile}"],
          "options": {
            "lintFilePatterns": ["apps/next/**/*.{ts,tsx,js,jsx}"]
          }
        },
        "build": {
            "executor": "nx:run-commands",
            "outputs": [
                "{workspaceRoot}/apps/next/out",
                "{workspaceRoot}/apps/next/.next"
            ],
            "options": {
                "command": "next build",
                "cwd": "apps/next"
            }
        },
        "dev": {
            "executor": "nx:run-commands",
            "options": {
                "command": "next dev",
                "cwd": "apps/next"
            }
        },
        "clean": {
            "executor": "nx:run-commands",
            "options": {
                "command": "rimraf .next node_modules/.cache",
                "cwd": "apps/next"
            }
        }
    },
    "tags": [
        "type:app",
        "scope:frontend"
    ]
}
