{
    "name": "@app/nest",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/nest/src",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "outputs": [
                "{workspaceRoot}/apps/nest/dist"
            ],
            "options": {
                "command": "nest build",
                "cwd": "apps/nest"
            }
        },
        "dev": {
            "executor": "nx:run-commands",
            "options": {
                "command": "nest start --watch",
                "cwd": "apps/nest"
            }
        }
    },
    "tags": [
        "type:app",
        "scope:backend"
    ]
}