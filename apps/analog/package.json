{
  "name": "@app/analog",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "@/*": "./src/*"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "prebuild": "pnpm run clean",
    "build": "vite build",
    "postbuild": "node scripts/verify-build.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist node_modules/.cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@analogjs/router": "^1.13.0",
    "@angular/animations": "^19.1.0",
    "@angular/common": "^19.1.0",
    "@angular/compiler": "^19.1.0",
    "@angular/core": "^19.1.0",
    "@angular/forms": "^19.1.0",
    "@angular/platform-browser": "^19.1.0",
    "@angular/platform-browser-dynamic": "^19.1.0",
    "@angular/router": "^19.1.0",
    "@ngrx/operators": "^19.0.0",
    "@ngrx/signals": "^19.0.0",
    "rxjs": "~7.8.1",
    "tailwindcss": "^4.0.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0",
    "@app/contracts": "workspace:*"
  },
  "devDependencies": {
    "@analogjs/platform": "^1.13.0",
    "@analogjs/vite-plugin-angular": "^1.13.0",
    "@angular/build": "^19.1.0",
    "@angular/cli": "^19.1.0",
    "@angular/compiler-cli": "^19.1.0",
    "@analogjs/vitest-angular": "^1.13.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.18.0",
    "openapi-typescript": "^7.5.0",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.11",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}